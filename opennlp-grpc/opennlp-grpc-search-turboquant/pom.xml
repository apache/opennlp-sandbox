<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.opennlp</groupId>
        <artifactId>opennlp-grpc</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>opennlp-grpc-search-turboquant</artifactId>
    <name>Apache OpenNLP gRPC Backend :: TurboQuant Search</name>
    <description>
        Quantized vector search add-on for the OpenNLP gRPC server: the
        TurboQuant search index provider (live workspaces, persistence, and
        exhaustive immutable bundles) plus the offline bundle builder CLI. The
        server discovers the provider through the search SPI when this jar is
        on the classpath; without it the flat-float and terms providers still
        serve dynamic search.
    </description>

    <dependencies>
        <!-- SPI surface (SearchIndexProviderFactory and its carrier types).
             Provided: at deploy time this jar sits on the server classpath. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-spi</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Generated protobuf message types used by the bundle format.
             Provided for the same reason as the SPI jar. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The offline bundle builder CLI embeds passages through the server's
             aggregate embedding provider factory; the serving-side provider needs
             the SPI alone. Provided: the CLI runs on the server classpath. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- TurboQuant quantization and immutable vector indexes. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-embeddings</artifactId>
            <version>${opennlp.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The registry and service tests moved here with the provider live in the
             same test package as the server module's search tests and reuse their
             fixtures through the server test jar. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-service</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
