<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.opennlp</groupId>
        <artifactId>opennlp-sandbox</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>opennlp-grpc</artifactId>
    <name>Apache OpenNLP gRPC</name>
    <packaging>pom</packaging>

    <modules>
        <module>opennlp-grpc-api</module>
        <module>opennlp-grpc-spi</module>
        <module>opennlp-grpc-service</module>
        <module>opennlp-grpc-backend-tei</module>
        <module>opennlp-grpc-backend-openvino</module>
        <module>opennlp-grpc-backend-static</module>
        <module>opennlp-grpc-dl</module>
        <module>opennlp-grpc-installer</module>
        <module>opennlp-grpc-search-turboquant</module>
        <module>opennlp-grpc-store-s3</module>
        <module>opennlp-grpc-search-lucene</module>
        <module>opennlp-grpc-formats</module>
        <module>opennlp-grpc-sink-grpc</module>
        <module>opennlp-grpc-webapp-api</module>
        <module>opennlp-grpc-webapp-default</module>
        <module>opennlp-grpc-webapp</module>
        <module>opennlp-grpc-distr</module>
        <module>opennlp-grpc-integration-tests</module>
    </modules>

    <properties>
        <!--
          TEMPORARY: pin to a locally-built OpenNLP from the apache/opennlp branch
          OPENNLP-1833-grpc-helper, which merges apache main plus every open OpenNLP pull
          request. Only features visible in the apache review queue are in scope for this
          service. The distinct version keeps a plain 3.0.0-SNAPSHOT refresh from clobbering
          it and is never deployed anywhere. Revert to ${opennlp.version} inherited from the
          parent (3.0.0-SNAPSHOT) once the depended-on PRs are merged to apache/opennlp main.
        -->
        <opennlp.version>3.0.0-OPENNLP-1833-SNAPSHOT</opennlp.version>
        <grpc.version>1.83.1</grpc.version>
        <protobuf.version>3.25.8</protobuf.version>
        <picocli.version>4.7.7</picocli.version>
        <junit5-system-exit.version>2.0.3</junit5-system-exit.version>
        <awaitility.version>4.3.0</awaitility.version>
    </properties>

    <build>
        <plugins>
            <!--
              Apache-grade Javadoc enforcement for the gRPC modules: override the sandbox parent's
              doclint=none so missing/malformed Javadoc fails the build. The sourcepath restriction
              keeps the check on hand-written sources; the generated protobuf module
              (opennlp-grpc-api) has no src/main/java and is therefore not scanned here. Its API
              is documented through the protoc-gen-doc output instead.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <sourcepath>src/main/java</sourcepath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <configuration>
                    <excludes combine.children="append">
                        <!-- Generated by uv; TOML comments would not be retained on regeneration. -->
                        <exclude>examples/python-client/uv.lock</exclude>
                        <!-- JSON carries no comments; the license is declared in its license field. -->
                        <exclude>examples/node-client/package.json</exclude>
                        <!-- Generated by npm. -->
                        <exclude>examples/node-client/package-lock.json</exclude>
                        <exclude>examples/node-client/node_modules/**</exclude>
                        <!-- Build output of the standalone example project, which is not a reactor module. -->
                        <exclude>examples/java-client/target/**</exclude>
                        <!-- Go module metadata carries no comments; generated stubs live in gen/. -->
                        <exclude>examples/go-client/go.mod</exclude>
                        <exclude>examples/go-client/go.sum</exclude>
                        <exclude>examples/go-client/gen/**</exclude>
                        <!-- GraalVM reachability metadata is JSON, which carries no comments. -->
                        <exclude>docker/native/config/**</exclude>
                        <exclude>docker/native/out/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
