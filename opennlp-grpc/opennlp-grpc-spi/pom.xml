<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.opennlp</groupId>
        <artifactId>opennlp-grpc</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>opennlp-grpc-spi</artifactId>
    <name>Apache OpenNLP gRPC :: Service Provider Interfaces</name>
    <description>
        ServiceLoader interfaces and their carrier types for extending the OpenNLP
        gRPC server: embedding backends, model backends, search index providers,
        dictionary formats, and vocabulary stores. Add-on modules compile against
        this artifact only; the server supplies it at run time.
    </description>

    <!--
      This artifact is the compile-time surface of every add-on jar, so its
      dependency list is deliberately minimal and additions deserve the same
      scrutiny as public API changes.
    -->
    <dependencies>
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-tools</artifactId>
            <version>${opennlp.version}</version>
        </dependency>
        <!-- VectorIndex in the search provider contract. The onnxruntime jar is
             excluded for the same reason as in opennlp-grpc-service: exactly one
             runtime flavor is supplied by the module that owns ONNX inference. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-embeddings</artifactId>
            <version>${opennlp.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- StatusRuntimeException in AnalysisException's gRPC mapping. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
