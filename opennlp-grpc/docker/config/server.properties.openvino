# OpenVINO demonstration configuration: embeddings are delegated to the ovms
# service on the compose network, which serves the fused tokenizer + MiniLM +
# pooling graph exported by opennlp-grpc-integration-tests/scripts/ovms-server.sh.
model.embedder.minilm.openvino.target=ovms:9000
model.embedder.minilm.openvino.model_name=embedder
model.embedder.default_id=minilm

# The demo node installs catalog models, keeps trainer artifacts and saves live indexes
# under its state volume, so Models & data, Build index, Trainer and Lifecycle all work.
model.catalog_root=/srv/opennlp/catalog
vocabulary.artifact_root=/srv/opennlp/artifacts
search.persist.root=/srv/opennlp/checkpoints
