<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.opennlp</groupId>
        <artifactId>opennlp-grpc</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>opennlp-grpc-store-s3</artifactId>
    <name>Apache OpenNLP gRPC Add-on :: S3 Vocabulary Store</name>
    <description>
        S3 vocabulary artifact store for the OpenNLP gRPC server, discovered
        through the vocabulary store SPI by the s3 scheme of the configured
        artifact root. Built against the SPI alone; the shaded -all jar bundles
        the AWS SDK so one jar dropped on the server classpath is enough.
    </description>

    <properties>
        <awssdk.version>2.46.17</awssdk.version>
    </properties>

    <dependencies>
        <!-- SPI surface (VocabularyStoreProvider and VocabularyStore).
             Provided: at deploy time this jar sits on the server classpath. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-spi</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The resolution test exercises the server's scheme-based store resolver. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Self-contained drop-in jar: the add-on with the AWS SDK bundled, so a
                 deployment adds exactly one file next to the server. The plain jar
                 stays the Maven artifact for builds that manage dependencies. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
