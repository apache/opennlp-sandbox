<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.opennlp</groupId>
        <artifactId>opennlp-grpc</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>opennlp-grpc-installer</artifactId>
    <name>Apache OpenNLP gRPC Add-on :: Model Installer</name>
    <description>
        Model download add-on for the OpenNLP gRPC server: the built-in
        installable model catalog (metadata only, never model bytes) discovered
        through the catalog SPI, and the standalone install-resource CLI for
        checksum-pinned downloads. Without this jar the server serves an empty
        catalog and refuses installs honestly.
    </description>

    <dependencies>
        <!-- SPI surface (ModelCatalogProvider and its carrier records).
             Provided: at deploy time this jar sits on the server classpath. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-spi</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Generated protobuf message types used by the catalog descriptors.
             Provided for the same reason as the SPI jar. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-grpc-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- ResourceInstaller: bounded, checksum-verified downloads. -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
